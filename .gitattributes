# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicitly declare text files you want to always be normalized and converted
*.py text diff=python
*.md text
*.txt text
*.tex text
*.bib text
*.json text
*.csv text
*.yml text
*.yaml text

# Denote all binary files that should not be modified
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.ipynb text
